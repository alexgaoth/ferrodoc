target/
.iterate/

# The Python binding builds outside the cargo workspace.
bindings/python/target/
bindings/python/dist/
__pycache__/
*.pyc

# `samples/generate.sh --check` copies the tree into a `mktemp -d -p .`
# scratch dir and removes it on EXIT/INT/TERM. SIGKILL, an OOM or a power
# cut leaves it behind, and a later `git add -A` would commit a duplicate
# of `samples/`.
samples-check.*

# `scripts/sweep-epub-xhtml.sh` unpacks every corpus EPUB into a scratch
# dir beside itself, for the same reason and with the same trap.
sweep-epub.*

# Working notes for the agents that build this, not for anyone reading the
# repository: the roadmap with its unlanded items, the per-crate rules, and
# the adoption research behind them. A bare name matches at every level, so
# this covers the nested `CLAUDE.md` files too.
TODO.md
CLAUDE.md
ADOPTION.md

# `.rust-corpus/` is a local reference library: upstream Rust performance,
# API, memory and agent-instruction guides fetched by its own `fetch.sh`,
# plus the distilled rules and the evaluation written from them. Upstream
# copies are for reading here, not for redistribution from this repo, and
# the folder is a few MB — so it stays out of the tree like the other
# working notes above.
.rust-corpus/
